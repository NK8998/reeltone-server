# Copy to reviews/.env.
APP_ENV=development
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

REVIEWS_ORIGIN=http://localhost:3101
AUTH_ISSUER=http://localhost:3000
# Compose supplies an internal Auth URL for server-to-server calls.
# AUTH_INTERNAL_URL=http://127.0.0.1:3000
AUTH_CLIENT_ID=reviews-local
AUTH_CLIENT_SECRET=
REVIEWS_SESSION_SECRET=
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=reeltone_reviews
PGUSER=reeltone_reviews
PGPASSWORD=reeltone-local-reviews
# Space-separated ReelTone account UUIDs for Reviews moderators.
REVIEWS_ADMIN_IDS=
