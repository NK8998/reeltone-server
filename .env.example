PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=reeltone_auth
PGUSER=reeltone_auth
PGPASSWORD=reeltone-local-auth

AUTH_ISSUER=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Set to 1 behind the production Nginx proxy.
AUTH_TRUST_PROXY=0
AUTH_JWKS_FILE=.keys/oidc.json
# Run npm run keys:generate to create the key file and print a cookie secret.
AUTH_SECRET=
# Register each ReelTone app here once its actual callback is available.
OIDC_CLIENTS='[{"client_id":"local","client_name":"Local preview","client_uri":"http://localhost:3100","redirect_uris":["http://localhost:3100/callback"],"token_endpoint_auth_method":"none"}]'

MAIL_TRANSPORT=smtp
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Existing deployments can set SMTP_URL to override the SMTP_* settings above.
SMTP_URL=
MAIL_FROM=ReelTone <auth@reeltone.site>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
